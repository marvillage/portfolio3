# ── Contact form → online database (Supabase) ───────────────────────────────
# Create a free project at https://supabase.com, then add these.
# The contact API route (app/api/contact/route.ts) inserts submissions into a
# "messages" table. If these are unset, the form still works and falls back to
# opening the user's email client via mailto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Formspree fallback (https://formspree.io) — if set, the API route
# will also forward the message to your email via Formspree.
FORMSPREE_ENDPOINT=

# ── The Daily Commit page (/daily-commit) ─────────────────────────────────
# GitHub token for the GraphQL API (required for editions; also lifts the Live
# Stats rate limit). Free: github.com/settings/personal-access-tokens → Fine-
# grained token → "Public repositories (read-only)", no extra permissions.
GITHUB_TOKEN=

# Upstash Redis (free tier) for the page-view counter, edition
# numbers and a 12 h cache. Easiest: Vercel project → Storage → Create →
# Upstash for Redis → connect; it adds these for you.
# Without them the page still works locally (in-memory) and in production
# editions still print, but page views are hidden and nothing is cached.
KV_REST_API_URL=
KV_REST_API_TOKEN=
